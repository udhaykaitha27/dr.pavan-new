# ----------------------------------------------------------------------
# Apache Htaccess Rules - Dr. Pavan Kumar Ediga Rebuild
# ----------------------------------------------------------------------

# Prevent Directory Browsing and disable MultiViews negotiation
Options -Indexes -MultiViews

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /

    # Rewrite pretty URLs to PHP files
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Map URLs
    RewriteRule ^sitemap$ sitemap.php [L,QSA]
    RewriteRule ^thank-you$ thank-you.php [L,QSA]
    RewriteRule ^privacy-policy$ privacy-policy.php [L,QSA]
    RewriteRule ^terms$ terms.php [L,QSA]
    RewriteRule ^photos$ photos.php [L,QSA]
    RewriteRule ^videos$ videos.php [L,QSA]
    RewriteRule ^blogs$ blogs.php [L,QSA]
    RewriteRule ^spine-surgery$ spine-surgery.php [L,QSA]
    RewriteRule ^neuro-oncology$ neuro-oncology.php [L,QSA]
    RewriteRule ^neuro-trauma$ neuro-trauma.php [L,QSA]
    RewriteRule ^back-pain$ back-pain.php [L,QSA]
    RewriteRule ^headache$ headache.php [L,QSA]
    RewriteRule ^facial-nerve$ facial-nerve.php [L,QSA]
</IfModule>

# ----------------------------------------------------------------------
# Gzip Compression (PageSpeed Performance optimization)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Leverage Browser Caching
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Default cache expiration: 1 month
    ExpiresDefault "access plus 1 month"
    
    # CSS and JavaScript: 1 year (static cache busting can be done via query versioning)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Images and Media: 1 year
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Web Fonts: 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
</IfModule>

# Disable tracking of ETag headers since we use Cache-Control
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
